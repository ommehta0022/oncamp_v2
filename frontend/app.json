{
  "expo": {
    "name": "OnCampus",
    "slug": "oncampus",
    "version": "1.6.6",
    "runtimeVersion": "1.6.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oncampus",
    "backgroundColor": "#FAF9F6",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": true,
      "url": "https://oncampus-backend-production.up.railway.app/v1/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/ota-certificate.pem",
      "codeSigningMetadata": {
        "keyid": "oncampus-main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oncampus.app",
      "infoPlist": {
        "NSCameraUsageDescription": "OnCampus needs camera access to take photos and scan campus QR codes.",
        "NSPhotoLibraryUsageDescription": "OnCampus needs photo library access to attach media.",
        "NSMicrophoneUsageDescription": "OnCampus uses the microphone only when you choose to record a group voice note."
      }
    },
    "android": {
      "versionCode": 10606,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.oncampus.app",
      "permissions": ["CAMERA", "RECORD_AUDIO", "VIBRATE", "POST_NOTIFICATIONS", "REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow OnCampus to record a voice note only when you tap the microphone button."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F6",
          "dark": {
            "image": "./assets/images/splash-image.png",
            "backgroundColor": "#080809"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OnCampus to access your photos to attach media and update your profile.",
          "cameraPermission": "Allow OnCampus to access your camera to take photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "https://oncampus-backend-production.up.railway.app/v1",
      "otaRuntimeVersion": "1.6.6",
      "otaChannel": "production",
      "serverTriggeredUpdates": true,
      "nativeDirectInstaller": true,
      "nativeStartupOta": true
    }
  }
}
